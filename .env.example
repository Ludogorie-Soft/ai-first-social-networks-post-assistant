# ─── Database ─────────────────────────────────────────────────────────────────
# Two URLs for the SAME database, used by different things:
#
#   DATABASE_URL — the POOLED endpoint. Every application request goes through
#                  it (lib/db/client.ts). On Neon this is the host containing
#                  `-pooler`.
#   DIRECT_URL   — the DIRECT endpoint: the same host WITHOUT `-pooler`. Used
#                  only by schema commands (`db:deploy`, `db:migrate`,
#                  `db:status`, `db:push`), which prisma.config.ts routes here
#                  automatically.
#
# DIRECT_URL is REQUIRED for those schema commands — there is no fallback to
# DATABASE_URL. `prisma migrate` holds a session-level advisory lock, and through
# pgbouncer that lock can be orphaned onto a shared backend, making every later
# migration fail with P1002. If DIRECT_URL is unset, schema commands refuse to
# run rather than risk that — see prisma.config.ts for the exact error.
# Non-schema commands (generate, studio, validate) do not need it.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32 bytes encoded as 64 hex characters.
# Used to encrypt LLM API keys and Buffer OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LLM_ENCRYPTION_KEY=""

# ─── Buffer OAuth ─────────────────────────────────────────────────────────────
# Register your app at https://buffer.com/developers/apps
# The redirect URI must exactly match what is registered in your Buffer app.
BUFFER_CLIENT_ID=""
BUFFER_CLIENT_SECRET=""
BUFFER_REDIRECT_URI="http://localhost:3000/api/v1/buffer/callback"

# ─── AI / Generation ──────────────────────────────────────────────────────────
# Set to "true" to skip real LLM and image provider calls (deterministic mocks).
# Useful during development when API keys are not yet configured.
AI_MOCK_MODE="false"

# ─── LLM Providers ─────────────────────────────────────────────────────────────
# WHICH provider is used is NOT set here — a global admin activates providers and
# picks the default in the admin panel (stored as LlmConfig rows), and users may
# override per generation. Env only supplies credentials, model names, and URLs
# for the providers below. AI_MOCK_MODE=true bypasses all of them.

# ─── Groq ──────────────────────────────────────────────────────────────────────
# The Groq inference API (https://api.groq.com) — NOT xAI's Grok. Generous free
# tier; expect HTTP 429 rate limits on it under load.
# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: model to use (default: llama-3.3-70b-versatile).
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Create an API key at https://console.anthropic.com/settings/keys
# Required to activate the Claude provider.
ANTHROPIC_API_KEY=""
# Optional: model to use (default: claude-sonnet-4-6).
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY is shared between LLM generation and image generation
# (IMAGE_PROVIDER=OPENAI). One key covers both.
# Optional: model to use for LLM text generation (default: gpt-4.1-mini).
OPENAI_MODEL="gpt-4.1-mini"

# ─── Local Text Worker ─────────────────────────────────────────────────────────
# Use a self-hosted Ollama-compatible worker for text generation.
# Both URL and key are required to activate the Text Worker provider.
TEXT_WORKER_URL="http://192.168.31.102:3002"
TEXT_WORKER_API_KEY=""
# Optional: model to use (default: qwen3:8b).
TEXT_WORKER_MODEL="qwen3:8b"

# ─── RSS Article Translation Engine ────────────────────────────────────────────
# Which engine translates INGESTED ARTICLES. Affects nothing else — post generation,
# aspect mining, classification, product-page extraction and embeddings all keep
# using the admin-selected LLM exactly as before.
#
#   ollama  → the prompt-based path that has always run this pipeline: the admin's
#             default LLM provider, asked for structured JSON, with in-request
#             regeneration on a bad reply. THE DEFAULT.
#   madlad  → google/madlad400-3b-mt, a dedicated translation model served by the
#             SAME text worker on the SAME port under POST /translate. Requires the
#             worker-side setup in text-worker/madlad/README.md. It reuses
#             TEXT_WORKER_URL and TEXT_WORKER_API_KEY — there is no second worker URL.
#             The app splits an article and calls /translate once per segment
#             ({ text, sourceLanguage, targetLanguage }), so one article is typically
#             5–15 HTTP calls rather than one.
#
# Unset means "ollama". To roll back from MADLAD, set this to ollama (or delete the
# line) and restart the app — nothing else changes.
TRANSLATION_PROVIDER="ollama"

# Optional model override for the `ollama` engine. Unset = whatever the admin default
# LLM resolves to (today TEXT_WORKER_MODEL), which is the pre-existing behaviour.
# Applied ONLY when that default is the text worker: overriding the model of a cloud
# provider the admin selected would be a silent provider swap, so it is ignored (with
# a warning) in that case.
# TRANSLATION_OLLAMA_MODEL="qwen3:8b"

# Optional model override for the `madlad` engine (default: google/madlad400-3b-mt).
# One text worker serves ONE checkpoint — changing this needs a worker restart.
# TRANSLATION_MADLAD_MODEL="google/madlad400-3b-mt"

# Fallback from MADLAD to the prompt-based engine. OFF unless set to exactly "ollama".
# It fires ONLY on a technical fault (worker unreachable, non-2xx, malformed reply,
# timeout) and is logged at warn level naming both engines. A poor translation NEVER
# triggers it: that is the engine's answer, and hiding it behind another engine would
# defeat the point of running MADLAD at all.
# TRANSLATION_MADLAD_FALLBACK="ollama"

# ─── Semantic Embeddings (Phase 1.3 — local-first) ─────────────────────────────
# Selects the embedding backend for post semantic memory. Fully local-first:
# no cloud provider and no third-party API key is used.
#   worker  → the local TEXT_WORKER (POST {TEXT_WORKER_URL}/embed, bge-m3, 1024-dim).
#             Reuses TEXT_WORKER_URL + TEXT_WORKER_API_KEY. When either is unset
#             embeddings are SKIPPED cleanly and post generation continues normally.
#   mock    → deterministic offline vectors (also used when AI_MOCK_MODE=true).
#   (unset) → no active provider; embedding is skipped.
EMBEDDING_PROVIDER="worker"
# Optional: override the embedding vector dimension (default: 1024, matches the
# pgvector column and bge-m3). Only change alongside a vector-column migration.
# EMBEDDING_DIMENSIONS="1024"

# ─── Image Provider ────────────────────────────────────────────────────────────
# Selects the image generation backend.
# Supported values: IDEOGRAM (primary), MOCK (default/no key), FAL, OPENAI, LEONARDO.
# MOCK shows a placeholder image — no API key required.
# AI_MOCK_MODE=true overrides this setting regardless of what is set here.
IMAGE_PROVIDER="IDEOGRAM"

# ─── Ideogram Image Generation (primary provider) ──────────────────────────────
# Create an API key at https://ideogram.ai/manage-api
# Only required when IMAGE_PROVIDER=IDEOGRAM.
IDEOGRAM_API_KEY=""
# Optional: model version to use (default: V_2).
# Supported values: V_1, V_1_TURBO, V_2, V_2_TURBO, V_3
IDEOGRAM_MODEL="V_2"

# ─── Fal.ai Image Generation ───────────────────────────────────────────────────
# Create an API key at https://fal.ai/dashboard/keys
# Only required when IMAGE_PROVIDER=FAL.
FAL_API_KEY=""
# Optional: model to use (default: fal-ai/flux/schnell).
# Other options: fal-ai/flux/dev, fal-ai/flux-pro
FAL_MODEL="fal-ai/flux/schnell"

# ─── OpenAI Image Generation ───────────────────────────────────────────────────
# Only required when IMAGE_PROVIDER=OPENAI.
OPENAI_API_KEY=""
# Optional: model to use for image generation (default: gpt-image-1).
# Other supported values: dall-e-3, dall-e-2
OPENAI_IMAGE_MODEL="gpt-image-1"

# ─── Leonardo.ai Image Generation ─────────────────────────────────────────────
# Sign up at https://leonardo.ai and create an API key under API Access.
# Only required when IMAGE_PROVIDER=LEONARDO.
LEONARDO_API_KEY=""
# Optional: a specific Leonardo model ID (e.g. "b24e16ff-06e3-43eb-8d33-4416c2d75876").
# Leave blank to use the Leonardo default model.
LEONARDO_MODEL_ID=""
# Optional: override the Leonardo base URL (default: https://cloud.leonardo.ai).
# LEONARDO_API_URL="https://cloud.leonardo.ai"

# ─── Custom Worker Image Generation ───────────────────────────────────────────
# Use a self-hosted worker (e.g. ComfyUI wrapper) for image generation.
# Both variables are required when IMAGE_PROVIDER=WORKER.
# IMAGE_WORKER_URL: base URL of the worker. The app POSTs to {IMAGE_WORKER_URL}/generate-image
#   with a JSON body of { prompt, negativePrompt?, width?, height? }. A trailing
#   /generate-image (if present) is not duplicated. `negativePrompt` is comma-separated defect
#   keywords for the ComfyUI graph's negative conditioning input. `width`/`height` size the
#   latent and are always positive multiples of 8, chosen per channel by the app. Every
#   optional field is omitted when unset, so a worker build that does not read them yet keeps
#   working unchanged and falls back to its own defaults.
# IMAGE_WORKER_API_KEY: sent as x-worker-api-key header on every request.
IMAGE_WORKER_URL="http://localhost:3001"
IMAGE_WORKER_API_KEY=""

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Used to send email verification messages on registration.
# Any SMTP provider works (e.g. Brevo, Mailgun, Postmark, Gmail).
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
# Set to "true" only for port 465 (implicit TLS). Leave "false" for STARTTLS (587).
EMAIL_SECURE="false"
EMAIL_USER="your-smtp-username"
EMAIL_PASS="your-smtp-password"
# The From address shown in the email client.
EMAIL_FROM="contact@edamame.digital"

# ─── App URL ───────────────────────────────────────────────────────────────────
# Public base URL of the app — used to build verification links.
# On Vercel this is set automatically; override here for local development.
APP_URL="http://localhost:3000"

# ─── Background Worker ─────────────────────────────────────────────────────────
# Read by the queue worker process (`npm run worker`), NOT by the Next app.
#
# The worker is what actually executes queued jobs. Every cron route in this app
# only ENQUEUES — ingestion, translation, generation, the publishing sweep, the
# analytics refresh, and manual multi-channel bulk generation all wait for a
# worker to claim them. Nothing in the pipeline runs without one, and because the
# publishing sweep is the only path that hands posts to Buffer, a worker that is
# down does not merely delay scheduled posts: past their 90-minute grace window
# it strands them.
#
# It shares DATABASE_URL with the app; everything below has a working default, so
# an empty section is a valid configuration.

# Stable identity, recorded in the `workers` table. Defaults to `${hostname}:${pid}`,
# which self-names a single worker on a single box. Set it explicitly when running
# more than one, or the rows collide.
# WORKER_ID=""
# How many jobs this worker may run at once.
# WORKER_CONCURRENCY="1"
# How often an idle worker looks for work.
# WORKER_POLL_INTERVAL_MS="2000"
# Heartbeat cadence. Must stay comfortably shorter than the lease TTL — a worker
# whose heartbeat is stale is what tells an operator it has died. Only sent while
# a job is actively held (`busy`); an idle or dormant worker sends none, which is
# what lets it stop touching the database at all — see the dormancy block below.
# WORKER_HEARTBEAT_INTERVAL_MS="15000"
# How long a claimed job stays leased to this worker. The orchestrator renews the
# lease at a third of this while a handler runs, so a long job is not requeued out
# from under itself; this is the window in which a CRASHED worker's jobs become
# claimable again.
# WORKER_LEASE_TTL_MS="300000"
# Grace period for in-flight work to finish on SIGTERM/SIGINT before forced exit.
# WORKER_SHUTDOWN_GRACE_MS="30000"
# Wall-clock budget for ONE manual bulk-generation attempt. Far larger than the
# HTTP route's 240s, which is the point of queueing that work: a worker is not a
# request and has no function cap to lose a batch to. 30 minutes covers the
# largest request the form can make (10 topics x 4 channels = 40 full
# generations). Exceeding it is not a failure — the run ends with the posts it
# wrote plus an honest stop reason, and the job completes.
# WORKER_BULK_BUDGET_MS="1800000"

# ─── Worker dormancy (ACTIVE / DORMANT) ─────────────────────────────────────────
# The queue's database (Neon Free) suspends its compute after a few minutes with
# no activity — and any fixed poll interval shorter than that threshold, however
# small the query, resets the clock and prevents suspension forever. Slower
# polling does not help; only NOT polling does. So once the queue has been empty
# for WORKER_DORMANT_AFTER_MS, the worker disconnects entirely (zero queries)
# until either a wake signal arrives or WORKER_FALLBACK_POLL_MS elapses. Postgres
# stays the only source of truth throughout: a missed or failed wake costs
# latency, never a job. See worker/README.md, "ACTIVE / DORMANT", for the full
# design and the four handlers this deliberately does not touch.

# Empty-queue quiet time before going DORMANT. `0` disables dormancy and restores
# continuous polling (the pre-dormancy behaviour).
# WORKER_DORMANT_AFTER_MS="60000"
# Ceiling on a dormant wait — guarantees a missed wake is recovered within this
# window regardless. Must stay comfortably under the 90-minute window a manually
# scheduled post remains publishable for (lib/scheduling/publish-window.ts).
# WORKER_FALLBACK_POLL_MS="1800000"
# Bound on the dormant cleanup — `prisma.$disconnect()`. It needs one because
# that call can never return: disconnecting ends the Neon pool, and Pool.end()
# resolves only once every checked-out client is released, which a client leaked
# by a socket that died mid-query never is. The loop arms its wake subscription
# and fallback timer BEFORE disconnecting, so abandoning a stuck disconnect costs
# one cycle of an open connection and nothing else.
# WORKER_DORMANT_CLEANUP_TIMEOUT_MS="10000"
# Periodic stale-lease reaping. `0` (default) reaps only at boot and at the start
# of each active burst, which is complete for a single worker — the only lease it
# can find expired is one it abandoned by crashing. Set a positive interval only
# when running MORE THAN ONE worker, where a lease abandoned by a different
# process needs recovering without waiting for this one to wake.
# WORKER_REAP_INTERVAL_MS="0"

# Shared secret for the wake listener (`POST /wake`, HMAC-SHA256, constant-time
# compared, replay- and rate-limited — see lib/security/wake-auth.ts). MUST match
# WORKER_WAKE_SECRET below in the Next app's own environment. Unset disables the
# listener; the worker still runs correctly on WORKER_FALLBACK_POLL_MS alone.
# WORKER_WAKE_SECRET=""
# Loopback port the wake listener binds. Reachability is the tunnel's job (e.g. a
# Tailscale Funnel on port 10000) — this socket itself never faces the network.
# WORKER_WAKE_PORT="3003"
# WORKER_WAKE_HOST="127.0.0.1"
# In-memory rate limit on /wake. Deliberately never Neon-backed: a rate limiter
# that queried the database would defeat the entire point of this mechanism.
# WORKER_WAKE_MAX_PER_MINUTE="60"

# ─── Worker wake signal (read by the Next app, NOT the worker) ─────────────────
# After every successful enqueueJob, the Next app fires a best-effort, signed
# wake request at the worker so a dormant worker picks the job up in seconds
# instead of on its next WORKER_FALLBACK_POLL_MS tick. Both are optional — with
# either unset, enqueueing still succeeds and the job still runs, just on the
# worker's own schedule. Never set WORKER_WAKE_URL to point at this same
# process; the worker sets WORKER_PROCESS=1 itself precisely so it never tries to
# wake itself over the network.
#
# Base URL of the worker's wake listener, reachable from Vercel — e.g. a
# Tailscale Funnel URL on port 10000. The app POSTs to {WORKER_WAKE_URL}/wake
# (the path is appended automatically if omitted here).
# WORKER_WAKE_URL="https://your-machine.tailXXXX.ts.net:10000"
# Must be byte-identical to WORKER_WAKE_SECRET above, in the worker's environment.
# WORKER_WAKE_SECRET=""

# ─── CrewAI multi-agent sidecar (MAC WORKER ONLY — never set in Vercel) ───────
# The inner Writer → Editor → QA loop runs in a local Python sidecar that binds
# 127.0.0.1 only (see sidecar/crewai/README.md). Every multi-agent generation
# executes in the Mac worker process, which is where that sidecar lives, so
# these variables belong ONLY in the worker's environment.
#
# Do NOT configure them in Vercel. A serverless function dialling a loopback URL
# would reach the FUNCTION's own loopback — it would either hang or connect to
# something unrelated. With CREW_SIDECAR_URL unset, a multi-agent run fails
# loudly with CREW_SIDECAR_NOT_CONFIGURED and never falls back to another
# strategy: falling back would move an A/B post into the other arm and corrupt
# the experiment, in exactly the conditions most likely to correlate with
# something else about the run.
#
# The URL is validated as loopback at construction and a non-loopback value is
# REFUSED without being dialled — 127.0.0.1, localhost or [::1] only.
# CREW_SIDECAR_URL="http://127.0.0.1:49510"
#
# The port the SIDECAR PROCESS ITSELF binds. Read by sidecar/crewai/app.py —
# NOT by this app and not by the worker, which both learn the port from
# CREW_SIDECAR_URL above. Unset, it defaults to 49510. Keep the two in step:
# they are two halves of one address, and a mismatch is a sidecar listening
# where nothing will ever call it.
# CREW_SIDECAR_PORT="49510"
#
# Shared secret, sent as the x-worker-api-key header. Must be byte-identical to
# CREW_SIDECAR_API_KEY in the sidecar's own environment.
# CREW_SIDECAR_API_KEY=""
#
# Hard abort cap for ONE /crew/post call. Unset, the compile-time default is the
# loop's own worst case: (3 + 3R) agent calls at Ollama's 300s per-call ceiling,
# i.e. 45 minutes at R=2. That is a ceiling against a wedged run holding a job
# lease, NOT an expectation — set this from measured p95 plus headroom once the
# latency measurement on the Mac is done (README.md §7).
#
# This is the AUTHORITATIVE end-to-end deadline, and the only one: the client
# dials with node:http rather than fetch, because undici enforces a 300s
# headersTimeout of its own and the sidecar sends no response byte until the
# whole generation is finished. A live run with the value below once failed at
# five minutes with UND_ERR_HEADERS_TIMEOUT, having never consulted it.
# CREW_SIDECAR_TIMEOUT_MS="2700000"
#
# Reaching this timeout does NOT cancel the generation — a synchronous CrewAI
# kickoff cannot be cancelled safely, so the sidecar finishes the run and keeps
# its single-flight slot. Expect the next call to be refused `crew_busy`; that
# is truthful, not a fault. GET /health reports `busy`, `runningForMs` and
# `clientDisconnected` so an abandoned run can be recognised as one.
#
# ── Which model the multi-agent loop runs (MAC WORKER ONLY) ──────────────────
#
# Two variables, because two questions are being answered:
#
#   TEXT_WORKER_MODEL   the SINGLE-agent model, and the A/B fairness model.
#                       Every single-agent generation runs it, and so does an
#                       `ab_split` MULTI run — an experiment comparing single
#                       against multi is worthless if the arms also differ in
#                       the model, so an assigned run pins this on both sides
#                       and measures orchestration alone.
#
#   MULTI_AGENT_MODEL   the NORMAL multi-agent model — `user_override` (a person
#                       chose "Multi-agent") and `global_default` (an admin made
#                       multi the site default). Not a measurement, so nothing
#                       requires it to equal the single-agent model.
#
# Unset, a normal multi run falls back to TEXT_WORKER_MODEL, which is exactly
# the behaviour before this variable existed. A blank value counts as unset.
#
# The reason this is not one variable: the Writer → Editor → QA loop was
# validated end-to-end on qwen3.5:35b-a3b-q4_K_M, while production single-agent
# generation runs qwen3:8b. With one variable the only choices were to move
# every single-agent generation onto a 35B model or to run the multi loop on an
# 8B model it was never validated against. Two variables remove the choice.
#
# `ab_split` deliberately IGNORES this — see multiAgentInferenceProfile() in
# lib/ai/strategy/experiment-inference.ts.
# MULTI_AGENT_MODEL="qwen3.5:35b-a3b-q4_K_M"

{
  "name": "ai-first-social-networks-post-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "worker": "npx tsx worker/src/index.ts",
    "seed:editor": "node scripts/seed-editor.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "backfill:embeddings": "npx tsx scripts/backfill-embeddings.ts",
    "cleanup:invalid-feed-items": "npx tsx scripts/cleanup-invalid-feed-items.ts",
    "refresh:source-images": "npx tsx scripts/refresh-source-images.ts",
    "semantic:evaluate": "npx tsx scripts/evaluate-semantic-gate.ts",
    "translate:benchmark": "npx tsx scripts/benchmark-translation.ts",
    "translate:verify": "npx tsx scripts/verify-translation-provider.ts",
    "translate:next": "npx tsx scripts/translate-next-feed-item.ts",
    "ingest:one": "npx tsx scripts/ingest-one-source.ts",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test \"app/**/*.test.ts\" \"i18n/**/*.test.ts\" \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\" \"worker/**/*.test.ts\"",
    "crew:verify": "npx tsx scripts/verify-crew-sidecar.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@mozilla/readability": "^0.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
